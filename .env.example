# Copy this file to `.env` and fill in real debug values.
# `.env` is gitignored and must never be committed.
#
# Chat endpoint used by field_extractor.extract_fields:
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-...
OPENAI_MODEL=deepseek-v4-flash

# Comma-separated origins allowed to call the API from a different host.
# Leave unset when FastAPI serves both the API and the static site (same
# origin, no CORS headers needed):
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# DeepSeek thinking is disabled automatically when the endpoint host contains
# "deepseek" (thinking mode rejects the forced tool_choice). Only set this if
# you need to override that default, e.g.:
# OPENAI_CHAT_EXTRA_BODY={"thinking":{"type":"enabled"}}

# Embeddings (used once the local embedding service is running).
# Leave unset while only running integration_test.py (small corpus skips them).
# OPENAI_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_MODEL=
