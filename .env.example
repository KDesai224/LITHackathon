# Copy this file to `.env` and fill in real debug values.
# `.env` is gitignored and must never be committed.
#
# Chat endpoint used by field_extractor.extract_fields:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Embeddings (used once the local embedding service is running).
# Leave unset while only running integration_test.py (small corpus skips them).
# OPENAI_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_MODEL=
